<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hardening audit {{ compliance_audit_stamp }}</title>
<style>
  :root { --bg:#fff; --fg:#1b1f24; --muted:#59636e; --line:#d8dee4; --card:#f6f8fa; --pass:#1a7f37; --fail:#cf222e; --skip:#8c959f; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0d1117; --fg:#e6edf3; --muted:#9198a1; --line:#30363d; --card:#151b23; --pass:#3fb950; --fail:#f85149; --skip:#6e7681; }
  }
  * { box-sizing: border-box; }
  body { margin:0; padding:24px 16px; background:var(--bg); color:var(--fg); font:15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  p.meta { color: var(--muted); margin: 0 0 24px; }
  table { width:100%; border-collapse: collapse; }
  th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 13px; }
  .bar { height:8px; background:var(--line); border-radius:4px; overflow:hidden; min-width:80px; }
  .bar > span { display:block; height:100%; background:var(--pass); }
  .low > span { background: var(--fail); }
  .tag { font-weight:600; font-size:12px; }
  .PASS { color:var(--pass); } .FAIL { color:var(--fail); } .SKIP { color:var(--skip); }
  details { background:var(--card); border:1px solid var(--line); border-radius:8px; margin:12px 0; padding:0 14px; }
  summary { cursor:pointer; padding:12px 0; font-weight:600; }
  summary small { color:var(--muted); font-weight:400; margin-left:8px; }
  .num { white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) { .hide-sm { display:none; } }
</style>
</head>
<body>
<main>
  <h1>Hardening audit</h1>
  <p class="meta">Generated {{ compliance_audit_stamp }} &middot; {{ ansible_play_hosts | length }} host(s)</p>

  <table>
    <thead><tr><th>Host</th><th class="hide-sm">Address</th><th>Score</th><th class="num">Pass</th><th class="num">Fail</th><th class="num hide-sm">N/A</th></tr></thead>
    <tbody>
{% for h in ansible_play_hosts | sort %}
{% set s = hostvars[h].compliance_audit_summary %}
      <tr>
        <td>{{ s.host | e }}</td>
        <td class="hide-sm">{{ s.address | e }}</td>
        <td><div class="bar {{ 'low' if s.score | float < 80 }}"><span style="width: {{ s.score }}%"></span></div>{{ s.score }}%</td>
        <td class="num PASS">{{ s.passed }}</td>
        <td class="num FAIL">{{ s.failed }}</td>
        <td class="num SKIP hide-sm">{{ s.skipped }}</td>
      </tr>
{% endfor %}
    </tbody>
  </table>

{% for h in ansible_play_hosts | sort %}
{% set s = hostvars[h].compliance_audit_summary %}
  <details{{ ' open' if s.failed | int > 0 }}>
    <summary>{{ s.host | e }}<small>{{ s.score }}% &middot; {{ s.failed }} failed</small></summary>
    <table>
      <thead><tr><th>Status</th><th>Category</th><th>Check</th></tr></thead>
      <tbody>
{% for status in ['FAIL', 'PASS', 'SKIP'] %}
{% for c in s.checks | selectattr('status', 'equalto', status) %}
        <tr><td class="tag {{ c.status }}">{{ c.status }}</td><td>{{ c.category | e }}</td><td>{{ c.title | e }}</td></tr>
{% endfor %}
{% endfor %}
      </tbody>
    </table>
  </details>
{% endfor %}
</main>
</body>
</html>
