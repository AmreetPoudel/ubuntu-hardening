# Managed by Ansible (linux-hardening) - local changes will be overwritten.
# Note: nginx does not inherit add_header into a server/location that defines its own add_header.
{% for name, value in nginx_security_headers.items() | sort %}
add_header {{ name }} "{{ value }}" always;
{% endfor %}
{% if nginx_hsts_enabled | bool %}
add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}{{ '; includeSubDomains' if nginx_hsts_include_subdomains | bool }}" always;
{% endif %}
