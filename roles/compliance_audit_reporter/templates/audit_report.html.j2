<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CIS Hardening Audit Report — {{ inventory_hostname }}</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 2rem; }
        .container { max-width: 1000px; margin: 0 auto; background: #1e293b; border-radius: 12px; padding: 2rem; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        h1 { margin-top: 0; color: #38bdf8; font-size: 1.8rem; }
        .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 1.5rem 0; }
        .card { background: #334155; padding: 1.2rem; border-radius: 8px; text-align: center; }
        .card .number { font-size: 2rem; font-weight: bold; margin-top: 0.5rem; }
        .pass-color { color: #4ade80; }
        .fail-color { color: #f87171; }
        .info-color { color: #38bdf8; }
        table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
        th, td { padding: 0.8rem; text-align: left; border-bottom: 1px solid #475569; }
        th { background: #334155; color: #94a3b8; font-size: 0.85rem; text-transform: uppercase; }
        .badge-pass { background: rgba(74, 222, 128, 0.2); color: #4ade80; padding: 0.25rem 0.6rem; border-radius: 4px; font-weight: bold; font-size: 0.85rem; }
        .badge-fail { background: rgba(248, 113, 113, 0.2); color: #f87171; padding: 0.25rem 0.6rem; border-radius: 4px; font-weight: bold; font-size: 0.85rem; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🛡️ CIS Linux Hardening Audit Report</h1>
        <p><strong>Host:</strong> {{ inventory_hostname }} | <strong>OS:</strong> {{ ansible_distribution }} {{ ansible_distribution_version }} | <strong>Audited at:</strong> {{ ansible_date_time.iso8601 }}</p>

        <div class="metrics">
            <div class="card">
                <div>Compliance Score</div>
                <div class="number info-color">{{ (audit_pass_count | float / audit_total_count | float * 100) | round(1) }}%</div>
            </div>
            <div class="card">
                <div>Total Checks</div>
                <div class="number">{{ audit_total_count }}</div>
            </div>
            <div class="card">
                <div>Passed</div>
                <div class="number pass-color">{{ audit_pass_count }}</div>
            </div>
            <div class="card">
                <div>Failed</div>
                <div class="number fail-color">{{ audit_fail_count }}</div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Security Check Name</th>
                    <th>Status</th>
                    <th>Recommendation</th>
                </tr>
            </thead>
            <tbody>
                {% for item in audit_results %}
                <tr>
                    <td><strong>{{ item.category }}</strong></td>
                    <td>{{ item.name }}</td>
                    <td>
                        {% if item.status == 'PASS' %}
                        <span class="badge-pass">PASS</span>
                        {% else %}
                        <span class="badge-fail">FAIL</span>
                        {% endif %}
                    </td>
                    <td><small style="color: #94a3b8;">{{ item.recommendation }}</small></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
